{
  "name": "moguworkshop",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "mabinogi.elden-mogu.com/", "zone_name": "elden-mogu.com" },
    { "pattern": "mabinogi.elden-mogu.com/doll", "zone_name": "elden-mogu.com" },
    { "pattern": "mabinogi.elden-mogu.com/doll/", "zone_name": "elden-mogu.com" },
    { "pattern": "mabinogi.elden-mogu.com/mogugi", "zone_name": "elden-mogu.com" },
    { "pattern": "mabinogi.elden-mogu.com/mogugi/", "zone_name": "elden-mogu.com" },
    { "pattern": "mabinogi.elden-mogu.com/_shared/*", "zone_name": "elden-mogu.com" }
  ]
}
